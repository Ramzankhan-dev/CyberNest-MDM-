# Rename this file to .env and fill in your real values

# Get this from Supabase: Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres

# Any long random string — used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

PORT=5000
