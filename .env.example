# Rename this file to .env and fill in your real values

# Get this from Supabase: Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres

# Any long random string — used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

# For sending Forgot Password OTP emails — EmailJS (uses your own Gmail
# account via OAuth, no domain verification needed, works on Render's
# free tier since it's an HTTPS API call, not raw SMTP).
# Get these from emailjs.com after setting up a Service + Template:
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key

PORT=5000
