# Rename this file to .env and fill in your real values

# Get this from Supabase: Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres

# Any long random string — used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

# For sending Forgot Password OTP emails — a Gmail address + App Password
# (Google Account > Security > 2-Step Verification > App Passwords)
EMAIL_USER=youraddress@gmail.com
EMAIL_PASSWORD=your_16_char_app_password

PORT=5000
