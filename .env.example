# Rename this file to .env and fill in your real values

# Get this from Supabase: Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres

# Any long random string — used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

# For sending Forgot Password OTP emails — Resend (HTTPS API, works on
# Render's free tier unlike raw SMTP). Get this from resend.com:
# Sign up free, copy your API key from the dashboard (no domain
# verification needed to send to your OWN signup email in sandbox mode).
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=CyberNest <onboarding@resend.dev>

PORT=5000
