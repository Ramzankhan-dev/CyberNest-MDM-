# Rename this file to .env and fill in your real values

# Get this from Supabase: Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres

# Any long random string — used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

# For sending Forgot Password OTP emails — Brevo (HTTPS API, works on
# Render's free tier unlike raw SMTP). Get these from brevo.com:
# 1. Sign up free, verify a sender email under Senders & IP > Senders
# 2. Create an API key under Settings (gear icon) > SMTP & API > API Keys
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=youraddress@gmail.com

PORT=5000
